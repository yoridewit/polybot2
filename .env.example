# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Search (pick one) ─────────────────────────────────────────────────────────
# Free option — no key needed:
SEARCH_PROVIDER=duckduckgo

# Paid option — better quality:
# SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...

# ── Scheduling ────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=60

# ── Paper Trading ─────────────────────────────────────────────────────────────
INITIAL_PAPER_BALANCE=1000

# ── Market Filters ────────────────────────────────────────────────────────────
MIN_VOLUME_24H=1000
MIN_LIQUIDITY=500
MIN_DAYS_TO_RESOLVE=1
MAX_DAYS_TO_RESOLVE=60
MAX_CANDIDATES_PER_SCAN=20

# ── Betting Strategy ──────────────────────────────────────────────────────────
MIN_EDGE_THRESHOLD=0.08
KELLY_FRACTION=0.25
MAX_BET_FRACTION=0.05
MIN_CONFIDENCE=0.50

# ── Token Budget (per day) ────────────────────────────────────────────────────
DAILY_TOKEN_BUDGET=100000

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8000
